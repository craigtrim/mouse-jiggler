<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>MouseJiggler.Tests</RootNamespace>
    <AssemblyName>MouseJiggler.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The Settings window is laid out in code, so its layout is measured in tests. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MouseJiggler.Core\MouseJiggler.Core.csproj" />
    <ProjectReference Include="..\..\src\MouseJiggler.Windows\MouseJiggler.Windows.csproj" />
    <ProjectReference Include="..\..\src\MouseJiggler.App\MouseJiggler.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
